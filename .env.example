# Local-only PostgreSQL development credentials; change for any shared server.
POSTGRES_USER=guardian
POSTGRES_PASSWORD=guardian_dev_only
POSTGRES_DB=guardian
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://guardian:guardian_dev_only@127.0.0.1:5432/guardian

# Resolved relative to the project root by backend/app/config.py.
WORKSPACE_ROOT=data/workspaces
SCAN_OUTPUT_ROOT=data/scans
MAX_REPOSITORY_SIZE_MB=200
MAX_FILE_COUNT=30000
MAX_MANIFEST_SIZE_MB=8
MAX_ARTIFACT_SIZE_MB=100
GIT_CLONE_TIMEOUT_SECONDS=120
SYFT_TIMEOUT_SECONDS=120
OSV_ENABLED=true
OSV_TIMEOUT_SECONDS=20
GRYPE_ENABLED=true
GRYPE_TIMEOUT_SECONDS=180
NVD_ENABLED=true
# Optional free key from https://nvd.nist.gov/developers/request-an-api-key (50 vs 5 requests / 30 s)
NVD_API_KEY=
NVD_TIMEOUT_SECONDS=20
NVD_BUDGET_SECONDS=1200
NVD_CACHE_DAYS=7
NVD_CACHE_ROOT=data/nvd
MAX_ACTIVE_SCANS=1
# Optional AI analyst (off by default). Keys stay in this local file; never commit them.
AI_ENABLED=false
# AI_PROVIDER: groq (default), xai (Grok) or anthropic (Claude)
AI_PROVIDER=groq
GROQ_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
# Leave empty for the provider default (groq: openai/gpt-oss-120b, xai: grok-4.7)
AI_MODEL=
# Reasoning effort (groq gpt-oss: low|medium|high); empty uses the provider default
AI_EFFORT=
AI_TOOL_BUDGET=5
AI_EXTERNAL_BUDGET=2
AI_TIMEOUT_SECONDS=120
AI_WALL_CLOCK_SECONDS=300
# Sandbox validation of approved fixes. Project tests run only inside a container.
VALIDATION_RUN_TESTS=true
# podman or docker; leave empty to auto-detect
VALIDATION_CONTAINER_RUNTIME=
VALIDATION_TEST_TIMEOUT_SECONDS=900
VALIDATION_LOCK_TIMEOUT_SECONDS=300
# Pull requests for sandbox-validated fixes (Kestral never merges). Fine-grained token
# with Contents and Pull requests read/write on the repository you scan.
GITHUB_TOKEN=

API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

