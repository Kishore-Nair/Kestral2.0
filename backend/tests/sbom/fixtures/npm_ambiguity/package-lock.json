{
  "name": "tricky-app",
  "version": "0.0.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "tricky-app",
      "version": "0.0.1",
      "workspaces": ["packages/local-lib"],
      "dependencies": {
        "good-alias": "npm:real-pkg@^1.0.0",
        "bad-alias": "npm:expected-pkg@^1.0.0",
        "ghost": "^9.0.0",
        "local-lib": "*"
      },
      "optionalDependencies": {"fsevents": "^2.3.0"},
      "peerDependencies": {"react": ">=18"}
    },
    "node_modules/good-alias": {
      "name": "real-pkg",
      "version": "1.4.0",
      "peerDependencies": {"react": ">=18"}
    },
    "node_modules/bad-alias": {
      "name": "something-else",
      "version": "1.0.0"
    },
    "node_modules/local-lib": {
      "resolved": "packages/local-lib",
      "link": true
    },
    "packages/local-lib": {
      "name": "local-lib",
      "version": "0.0.0"
    }
  }
}
